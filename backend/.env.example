NODE_ENV=production
PORT=4000
APP_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com

DATABASE_URL=mysql://user:pass@localhost:3306/travelfinance
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=change-me-64-random-chars
# 32 bytes as 64 hex chars:  openssl rand -hex 32
ENCRYPTION_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=travelfinance-files
SIGNED_URL_TTL_SECONDS=300

SENDGRID_API_KEY=
MAIL_FROM=billing@example.com

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

OXR_APP_ID=

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# --- R8 production settings ---
# Self-service sign-up (default: off in production, on elsewhere)
ALLOW_SIGNUP=false
# Prometheus scrape token for /api/metrics (endpoint returns 404 when unset):  openssl rand -hex 24
METRICS_TOKEN=
# Backups (npm run backup): directory, how many to keep, and an encryption passphrase (store it in your password manager!)
BACKUP_DIR=/home/USER/backups
BACKUP_KEEP=14
BACKUP_PASSPHRASE=
# Set to false to silence per-request JSON logs
LOG_REQUESTS=true
# Suspending a customer needs a second admin operator's approval (default true). Set false only for single-operator installs.
PLATFORM_TWO_PERSON=true

# AI assistant (optional). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
